# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only, never exposed to the browser).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Maps Platform API Key (this one IS sent to the browser - restrict it by HTTP referrer
# in Google Cloud Console so nobody else can use it).
VITE_GOOGLE_MAPS_API_KEY=

# --- Security ---
# Secret used to sign session cookies. Use a long random value (32+ chars). On Vercel with
# Upstash configured, one is generated and stored automatically if this is empty. e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Vercel deployment ---
# Persistent storage for accounts / password resets. In Vercel: Storage -> Marketplace ->
# "Upstash for Redis" -> connect to this project; it sets these automatically.
# (Vercel KV's KV_REST_API_URL / KV_REST_API_TOKEN also work.) Without them, accounts are
# kept in memory on Vercel and reset whenever a function cold-starts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Initial passwords for the built-in operator accounts (only used the first time the
# account store is created). Never commit real values: .env is ignored by git.
# On Vercel: a role left empty can't sign in. Tick Preview as well as Production if you
# want to sign in on preview deployments.
# Locally: a role left empty gets a random password, printed in the terminal when it's created.
FLEETDIAG_PASSWORD_DEVELOPER=
FLEETDIAG_PASSWORD_FLEET_DIRECTOR=
FLEETDIAG_PASSWORD_FLEET_MANAGER=
FLEETDIAG_PASSWORD_TECHNICIAN=
FLEETDIAG_PASSWORD_DISPATCHER=

# Set to the number of reverse proxies in front of the app (e.g. 1 on Cloud Run) so the
# rate limiter sees real client IPs. Leave empty when running directly (automatic on Vercel).
TRUST_PROXY=

# Show password-reset codes on screen (there is no mail server in this prototype).
# Local demos and Vercel previews only: on by default there, set to false to turn it off.
# It can't be turned on for the live site, where people reset with their security questions.
OTP_DEMO_MODE=
